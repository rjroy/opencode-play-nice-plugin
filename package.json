{
  "name": "opencode-play-nice-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run tests/prompt-boundary.test.ts tests/config.test.ts tests/decision.test.ts tests/composition.test.ts tests/history.test.ts tests/reflection.test.ts && node node_modules/vitest/vitest.mjs run --config tests/reconnect/vitest.config.ts",
    "test:reconnect": "node node_modules/vitest/vitest.mjs run --config tests/reconnect/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test:native": "vitest run --config tests/native/vitest.config.ts",
    "test:native:guards": "vitest run --config tests/native/vitest.guards.config.ts",
    "test:native:assembled": "vitest run --config tests/native/vitest.config.ts tests/native/assembled-plugin.native.test.ts",
    "test:package": "vitest run --config tests/native/vitest.package.config.ts && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.2.2",
    "@opencode/plugin": "2.2.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
